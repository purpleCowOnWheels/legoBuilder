# Copy this file to `.env.local` and fill in keys if you want live API calls.

# Optional (recommended): parts list lookup from Rebrickable
REBRICKABLE_API_KEY=

# Optional: ChatGPT guide generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional: raise to avoid truncating verbose LDraw MPD outputs
OPENAI_MAX_OUTPUT_TOKENS=12000

# Required for the initial Ideas generation call. Typical values: low | medium | high
REASONING_LEVEL=medium

# Preview thumbnails are always image-only (generated via OpenAI Images).
# Required:
OPENAI_IMAGE_MODEL=gpt-image-1

# Optional: enable OpenAI validation tool loop for LDraw MPD self-correction (slower, but higher success rate)
OPENAI_USE_VALIDATION_TOOL_LOOP=0

# Optional: when generating the full MPD, generate it in batches of this many blueprint steps
# (higher = fewer OpenAI calls but higher risk of truncation)
BLUEPRINT_STEPS_PER_MPD_BATCH=6

# Optional: enable verbose OpenAI debug logs (writes to data/openai-debug/)
DEBUG_OPENAI=0

# Optional: OpenAI API timeout in milliseconds (default: 360000 = 6 minutes)
# Reasoning models + tool loops + visual feedback can take significant time
OPENAI_TIMEOUT_MS=360000

# Optional: LDInspector for collision detection (if installed)
# Default: /Users/dan.costanza/Applications/LDInspector/ldinspector-collision
# LDINSPECTOR_BIN=/path/to/ldinspector-collision

# Optional: Minimum similarity score for render validation (0-100)
MIN_SIMILARITY_SCORE=70

