{
  "name": "legobuilder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:openai": "node tests/openai-structured.test.mjs",
    "mcp:dev": "tsx mcp-server/src/index.ts",
    "mcp:install": "cd mcp-server && npm install",
    "mcp:inspect": "cd mcp-server && npx @modelcontextprotocol/inspector tsx src/index.ts",
    "mcp:logs": "tsx mcp-server/view-logs.ts",
    "mcp:logs:list": "tsx mcp-server/view-logs.ts --list",
    "mcp:logs:images": "tsx mcp-server/view-logs.ts --images --detailed"
  },
  "dependencies": {
    "next": "14.2.24",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "20.17.12",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.24",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.0",
    "typescript": "5.7.3"
  }
}
